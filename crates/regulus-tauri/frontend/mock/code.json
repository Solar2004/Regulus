      "README.md": "# Lighthouse\n\nA small HTTP service that says whether its parts are up.\n\n## Run\n\n```sh\npnpm install\npnpm start\n```\n\nIt listens on `PORT`, or on 3000.\n",
      "package.json": "{\n  \"name\": \"lighthouse\",\n  \"private\": true,\n  \"scripts\": {\n    \"start\": \"node dist/app.js\",\n    \"test\": \"vitest run\"\n  }\n}\n",
      "docs/guide.md": "# Guide\n\nEach part reports `up`, `down` or `unknown`. The service is up when none is down.\n",
      "src/app.ts": "import { createServer } from \"node:http\";\nimport { health } from \"./routes/health\";\nimport { port } from \"./lib/port\";\n\nconst server = createServer((request, response) => {\n  if (request.url === \"/health\") return health(response);\n  response.writeHead(404).end();\n});\n\nserver.listen(port(process.env));\n",
      "src/lib/port.ts": "const fallback = 3000;\n\n/** The port the server listens on. */\nexport function port(env: Record<string, string | undefined>): number {\n  const value = Number(env.PORT);\n  return Number.isInteger(value) && value > 0 ? value : fallback;\n}\n",
      "src/routes/health.ts": "import type { ServerResponse } from \"node:http\";\n\n/** Says the service is up. */\nexport function health(response: ServerResponse) {\n  response.writeHead(200, { \"content-type\": \"application/json\" });\n  response.end(JSON.stringify({ status: \"up\" }));\n}\n"
    },
    "working": {
      "AGENTS.md": "# Working in this repository\n\n- Run `pnpm test` before you say something works.\n- Keep handlers small: one file per route.\n",
      "NOTES.md": "# Notes\n\n- The health route answers before the database is up.\n",
      "README.md": "# Lighthouse\n\nA small HTTP service that says whether its parts are up.\n\n## Run\n\n```sh\npnpm install\npnpm start\n```\n\nIt listens on `PORT`, or on 3000.\n",
      "package.json": "{\n  \"name\": \"lighthouse\",\n  \"private\": true,\n  \"scripts\": {\n    \"start\": \"node dist/app.js\",\n    \"test\": \"vitest run\"\n  }\n}\n",
      "docs/guide.md": "# Guide\n\nEach part reports `up`, `down` or `unknown`. The service is up when none is down.\n",
      "src/app.ts": "import { createServer } from \"node:http\";\nimport { health } from \"./routes/health\";\nimport { port } from \"./lib/port\";\n\nconst server = createServer((request, response) => {\n  if (request.url === \"/health\") return health(response);\n  response.writeHead(404).end();\n});\n\nserver.listen(port(process.env));\n",
      "src/lib/port.ts": "const fallback = 8080;\n\n/** The port the server listens on: PORT if it is a port, else the fallback. */\nexport function port(env: Record<string, string | undefined>): number {\n  const value = Number(env.PORT);\n  return Number.isInteger(value) && value > 0 && value < 65536 ? value : fallback;\n}\n",
      "src/routes/health.ts": "import type { ServerResponse } from \"node:http\";\n\n/** Says the service is up. */\nexport function health(response: ServerResponse) {\n  response.writeHead(200, { \"content-type\": \"application/json\" });\n  response.end(JSON.stringify({ status: \"up\" }));\n}\n",
