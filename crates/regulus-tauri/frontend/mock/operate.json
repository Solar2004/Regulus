  "templates": [
    {
      "name": "echo",
      "description": "Writes what reaches go and sends it back on done",
      "path": "mock/templates/echo.toml",
      "vars": [
        {
          "name": "who",
          "description": "who is greeted"
        },
        {
          "name": "file",
          "description": "file the greeting goes to",
          "default": "greeting.txt"
        }
      ],
      "requires": [
        {
          "module": "regulus/files",
          "version": ">=0.1"
        }
      ],
      "text": "# Mock template: the real ones live in templates/ at the repo root.\nid = \"echo\"\nname = \"Echo for {{who}}\"\n",
      "profile": {
        "id": "echo",
        "name": "Echo for {{who}}",
        "project_id": null,
        "extends": null,
        "main_workflow_id": "main",
        "workflows": [
          {
            "id": "main",
            "name": "Echo",
            "kind": "main",
            "module_id": null,
            "ports": [
              {
                "id": "go",
                "name": "go",
                "capability": "text@1",
                "direction": "input",
                "kind": "then",
                "required": false
              },
              {
                "id": "done",
                "name": "done",
                "capability": "text@1",
                "direction": "output",
                "kind": "then",
                "required": false
              }
            ],
            "nodes": [
              {
                "id": "note",
                "name": "Write the greeting",
                "type": "write",
                "module_id": "regulus/files@0.1.0",
                "resource": null,
                "ports": [
                  {
                    "id": "in",
                    "name": "in",
                    "capability": "text@1",
                    "direction": "input",
                    "kind": "then",
                    "required": false
                  },
                  {
                    "id": "written",
                    "name": "written",
                    "capability": "path@1",
                    "direction": "output",
                    "kind": "then",
                    "required": false
                  }
                ],
                "config": {
                  "path": "{{file}}"
                },
                "position": {
                  "x": 350,
                  "y": 100
                },
                "internal_workflow_id": null,
                "exposed_parameters": []
              }
            ],
            "wires": [
              {
                "id": "go-note",
                "kind": "then",
                "from": {
                  "node_id": "self",
                  "port_id": "go"
                },
                "to": {
                  "node_id": "note",
                  "port_id": "in"
                }
              },
              {
                "id": "note-done",
                "kind": "then",
                "from": {
                  "node_id": "note",
                  "port_id": "written"
                },
                "to": {
                  "node_id": "self",
                  "port_id": "done"
                }
              }
            ],
            "layout": {
              "x": 0,
              "y": 0,
              "width": 900,
              "height": 400
            }
          }
        ]
      }
    },
