# The manifest of the `__ID__` local module: the same shape as any `regulus-module.toml`
# (docs/03-modules.md). `src/main.rs` sends it when the core asks. The core names the module
# `<project>/__ID__@<version>` whatever the part before `@` says; the version is the one
# after `@` (`version` in `regulus.toml` wins; with neither it is 0.0.0).
[module]
id             = "local/__ID__@0.1.0"
name           = "__NAME__"
requires_proto = "^1"

[[node]]
type = "__ID__"
name = "__NAME__"

  [[node.port]]
  id          = "in"
  capability  = "text@1"
  direction   = "input"
  kind        = "then"
  cardinality = "many"

  [[node.port]]
  id         = "out"
  capability = "text@1"
  direction  = "output"
  kind       = "then"

  [[node.field]]
  id      = "prefix"
  type    = "text"
  label   = "Prefix"
  default = ""
