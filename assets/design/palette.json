{
  "name": "Regulus Midnight",
  "description": "Bandas pizarra activas de Centaury: gradientes, tinta, bordes y gráficos monocromos; no usa su bloque .dark inactivo.",
  "reference": {
    "pages": ["https://centaury.ai", "https://centaury.ai/login"],
    "sourceRoot": "/home/artorias/Projectos/Centaury/web",
    "stylesheet": "src/app/globals.css (:root y text-ink; excluir .dark)",
    "verified": "2026-10-02",
    "scope": "Familia navbar/footer y bandas oscuras reales. La web activa combina fondo blanco y bandas pizarra; Regulus aplica estas bandas a sus paneles.",
    "adaptations": "Texto auxiliar usa navbar-icon; contorno de campos usa navbar-muted-foreground para contraste. Estados semánticos conservan pares legibles. Ver centaury-recipes.md."
  },
  "colors": {
    "canvas": "#1F2130",
    "sidebar": "#232532",
    "surface": "#2C2E3A",
    "raised": "#343748",
    "hover": "#3A3D50",
    "selected": "#3A3D50",
    "border": "#595E7A",
    "control-border": "#959FBF",
    "steel": "#777FA8",
    "accent": "#626A8B",
    "accent-hover": "#595E7A",
    "focus": "#ABB6CE",
    "text": "#EBEFF4",
    "text-secondary": "#C9D1E0",
    "text-muted": "#ABB6CE",
    "on-accent": "#FFFFFF",
    "paper": "#FFFFFF",
    "paper-ink": "#2C2E3A",
    "paper-muted": "#61688C",
    "paper-border": "#E6E9F1",
    "paper-panel": "#F0F2F7",
    "login-ground": "#F2F4F8",
    "chart-1": "#777FA8",
    "chart-2": "#ABB6CE",
    "chart-3": "#595E7A",
    "chart-4": "#DAE1EB",
    "chart-5": "#959FBF",
    "chart-cap": "#3F4356",
    "stack-1": "#E9EBF1",
    "stack-2": "#D4D8E1",
    "stack-3": "#B4BAC7",
    "stack-4": "#8A90A2",
    "stack-5": "#5A5F73",
    "stack-6": "#2C2E3A",
    "success": "#83C9AC",
    "success-bg": "#142A26",
    "warning": "#DDBA7B",
    "warning-bg": "#2D261B",
    "danger": "#EF9B9B",
    "danger-bg": "#321F29",
    "info": "#91B4E0",
    "info-bg": "#172B43"
  },
  "font": {
    "display": "'Epilogue', 'Segoe UI', system-ui, sans-serif",
    "ui": "'Sora', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "mono": "ui-monospace, 'SFMono-Regular', Consolas, 'Liberation Mono', monospace"
  },
  "radius": { "small": "6px", "control": "12px", "panel": "16px", "band": "24px", "dialog": "28px", "pill": "999px" },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "12": "48px" },
  "duration": { "fast": "120ms", "normal": "180ms" },
  "ease": { "standard": "cubic-bezier(0.16, 1, 0.3, 1)" },
  "gradient": {
    "band-radial": "radial-gradient(130% 100% at 50% 0%, #3a3d50 0%, #2c2e3a 48%, #1f2130 100%)",
    "band-linear": "linear-gradient(180deg, #343748 0%, #2c2e3a 55%, #232532 100%)",
    "cta": "linear-gradient(180deg, #3a3d50, #2c2e3a)",
    "ink": "linear-gradient(to bottom, #2c2e3a 45%, #626a8b 140%)",
    "ink-dark": "linear-gradient(to bottom, #ffffff 40%, #959fbf 135%)",
    "bar-strong": "linear-gradient(180deg, rgba(119,127,168,.5) 0%, rgba(119,127,168,.02) 100%)",
    "bar-weak": "linear-gradient(180deg, rgba(119,127,168,.26) 0%, rgba(119,127,168,.02) 100%)",
    "grid": "linear-gradient(to right, rgba(44,46,58,.03) 1px, transparent 1px), linear-gradient(to bottom, rgba(44,46,58,.03) 1px, transparent 1px)",
    "spot-border": "radial-gradient(240px circle at var(--spot-x, 50%) var(--spot-y, 50%), rgba(119,127,168,.55), transparent 70%)",
    "spot-fill": "radial-gradient(420px circle at var(--spot-x, 50%) var(--spot-y, 50%), rgba(119,127,168,.14), transparent 65%)"
  },
  "chart": { "height": "190px", "cap": "5px", "sliver": "3px", "gap": "3px", "grid": "rgba(44,46,58,.07)", "area-top": "rgba(119,127,168,.22)", "area-bottom": "rgba(119,127,168,0)" },
  "layout": { "container": "1152px", "shell": "1180px", "grid": "56px" },
  "shadow": {
    "rim": "inset 0 1px 0 rgb(255 255 255 / 0.10)",
    "overlay": "0 24px 80px -40px rgba(44,46,58,.3)"
  }
}
